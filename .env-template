## rename it as .env and fill in all the keys and names accordingly.

STORE_TYPE=pinecone
LLM_MODEL_NAME=<MODEL >
LLM_PROVIDER=<PROVIDER>
LLM_SEED=365
LLM_TEMPERATURE=0.0
SENTENCE_TRANSFORMER_MODEL=sentence-transformers/all-MiniLM-L6-v2
MEMORY_FILE=memory.json
URLS_FILE=agentP/urls.txt
PINECONE_API_KEY=<PINECONE_API_KEY>
PINECONE_ENVIRONMENT=gcpstart
PINECONE_INDEX_NAME=<PINE_CONE_INDEX>
PROMPT_FILE=agentP/src/prompts/System_Prompt.txt
INTERACTION_FILE=agentP/src/prompts/interaction.json
REFORMULATION_PROMPT=agentP/src/prompts/reformulated_prompt.txt
TELEGRAM_BOT_TOKEN=<TELEGRAM_TOKEN>
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=<LANG_SMITH_API_KEY>
LANGCHAIN_PROJECT=my-property-agent
# Leave empty to disable API key authentication
API_KEY=
# Prompt used by the scheduled cron job
CRON_SEARCH_PROMPT="PROMPT".
# SQLite file for persistent chat session history
SESSION_DB_FILE=sessions.db
# Selenium scraping browser WebDriver URL (used by scrape_se.py)
SBR_WEBDRIVER=
VANTAGE_API_KEY=
