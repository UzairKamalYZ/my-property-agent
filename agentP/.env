STORE_TYPE=pinecone
LLM_MODEL_NAME=llama3.2
LLM_PROVIDER=ollama
LLM_SEED=365
LLM_TEMPERATURE=0.0
SENTENCE_TRANSFORMER_MODEL=sentence-transformers/all-MiniLM-L6-v2
MEMORY_FILE=memory.json
URLS_FILE=../urls.txt
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=gcpstart
PINECONE_INDEX_NAME=property-agent
PROMPT_FILE=prompts/System_Prompt.txt
INTERACTION_FILE=prompts/interaction.json
REFORMULATION_PROMPT=prompts/reformulated_prompt.txt
TELEGRAM_BOT_TOKEN=
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=<LANG Smith Api Key>
LANGCHAIN_PROJECT=my-property-agent
# Leave empty to disable API key authentication
API_KEY=
# Prompt used by the scheduled cron job
CRON_SEARCH_PROMPT=Give me a list of 2 bed apartment in poland with price less than 1000.
# SQLite file for persistent chat session history
SESSION_DB_FILE=sessions.db
# Selenium scraping browser WebDriver URL (used by scrape_se.py)
SBR_WEBDRIVER=
